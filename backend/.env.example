# Copy to backend/.env. run.ps1 does this for you and fills in JWT_SECRET.

# Local database. Paths are relative to the backend folder.
DATABASE_URL=sqlite:///./eduverse.db

# Keeps people signed in across restarts. Never change it unless you want to sign everyone out.
JWT_SECRET=

# Hours a sign-in lasts without activity. Active users are renewed automatically.
JWT_HOURS=12

# Port for run.ps1. Port 8000 is used by another program on this machine.
PORT=8001

# Paste your OpenAI key after the = sign, then restart. Or save it in Super Admin, AI settings.
OPENAI_API_KEY=

# First Super Admin, used only when the database is empty.
SUPERADMIN_EMAIL=superadmin@eduverse.local
SUPERADMIN_PASSWORD=ChangeMe@123
