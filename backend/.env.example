# Copy to backend/.env. run.ps1 does this for you and fills in JWT_SECRET.

# Local database. Paths are relative to the backend folder.
DATABASE_URL=sqlite:///./eduverse.db

# Keeps people signed in across restarts. Never change it unless you want to sign everyone out.
JWT_SECRET=

# Hours a sign-in lasts without activity. Active users are renewed automatically.
JWT_HOURS=12

# Port for run.ps1. Port 8000 is used by another program on this machine.
PORT=8001

# Paste your OpenAI key after the = sign, then restart. Or save it in Super Admin, AI settings.
OPENAI_API_KEY=

# First Super Admin, used only when the database is empty.
SUPERADMIN_EMAIL=superadmin@eduverse.local
SUPERADMIN_PASSWORD=ChangeMe@123

# ---------------- security and scale (v44) ----------------
# REQUIRED in production: at least 32 random characters. The app refuses to start in production without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production
# Encrypts API keys saved in AI settings. If empty, a key is derived from JWT_SECRET. Back it up: losing it loses the saved keys.
# SETTINGS_KEY=
# Shared rate limits and caches across API copies. Without it, limits are per process.
# REDIS_URL=redis://localhost:6379/0
# 1 = the API also runs queued background work (one box). 0 = run `python -m app.worker` containers instead.
# EMBEDDED_WORKER=1
# Most model requests at once per API copy, how long a request waits for a slot, and the model timeout.
# AI_CONCURRENCY=8
# AI_WAIT_SECONDS=20
# AI_TIMEOUT=90
# Largest upload accepted, in MB.
# MAX_UPLOAD_MB=400
